# Copy to .env for local development (never commit the real .env file).
GARAGE_ADMIN_URL=http://192.0.2.10:3903
GARAGE_ADMIN_TOKEN=change-me
GARAGE_ADMIN_READ_ONLY=true
GARAGE_ADMIN_HTTP_HOST=0.0.0.0
GARAGE_ADMIN_HTTP_PORT=8000

# Optional: enables list_s3_objects/get_s3_object (leave unset to disable).
# GARAGE_ADMIN_S3_URL=http://192.0.2.10:3900
# GARAGE_ADMIN_S3_ACCESS_KEY_ID=change-me
# GARAGE_ADMIN_S3_SECRET_ACCESS_KEY=change-me
# GARAGE_ADMIN_S3_REGION=garage
